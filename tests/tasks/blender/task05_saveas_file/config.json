{
    "task_id": "05", 
    "task_name": "saveas_file",
    "description": "另存文件到指定路径",

    "application_info": {   
        "name": "blender",   
        "executable_path": "/home/agent/blender-git/build_linux_debug/bin/blender",
        "args": ["/home/agent/blender-git/metaball_cube.blend"]
    },

    "task_parameters": {   
        "file_dir": "/home/agent/blender-git",
        "file_name": "metaball_cube_copy.blend"
    },

    "instruction_template": "在blender中另存文件为${file_dir}/${file_name}.",

    "evaluation_setup": {    
