        },
        "saveas_file_detected": {
            "description": "检测到正在保存文件",
            "is_key_step": false 
        },
        "saveas_file_finished": {
            "description": "检测到保存文件成功",
            "is_key_step": true,
            "key_step_index": 1,
            "key_step_name": "成功保存指定文件"
        },
        "error": {
